# Script mode (cmake -P): writes OUT_FILE with the version of the sources in SRC_DIR.
#
# 1. SRC_DIR/SOURCE_VERSION exists (copy synced by scripts/local/sync_to_server.sh, no .git there):
#    commit / describe / dirty are read from it.
# 2. Otherwise git (read-only commands only).
# Falls back to "unknown" if neither is available.

set(_commit   "unknown")
set(_describe "unknown")
set(_dirty    "unknown")
set(_source   "none")

if(EXISTS "${SRC_DIR}/SOURCE_VERSION")
  # Lines "key=value"
  file(STRINGS "${SRC_DIR}/SOURCE_VERSION" _lines)
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^commit=(.*)$")
      set(_commit "${CMAKE_MATCH_1}")
    elseif(_line MATCHES "^describe=(.*)$")
      set(_describe "${CMAKE_MATCH_1}")
    elseif(_line MATCHES "^dirty=(.*)$")
      set(_dirty "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  set(_source "SOURCE_VERSION")
else()
  find_package(Git QUIET)
  if(GIT_FOUND)
    execute_process(
      COMMAND ${GIT_EXECUTABLE} --no-optional-locks -C ${SRC_DIR} rev-parse HEAD
      OUTPUT_VARIABLE _out RESULT_VARIABLE _rc
      OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_rc EQUAL 0)
      set(_commit "${_out}")
      set(_source "git")

      execute_process(
        COMMAND ${GIT_EXECUTABLE} --no-optional-locks -C ${SRC_DIR} describe --always --tags
        OUTPUT_VARIABLE _out RESULT_VARIABLE _rc
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      if(_rc EQUAL 0)
        set(_describe "${_out}")
      endif()

      # --no-optional-locks: status does not refresh/write the index
      execute_process(
        COMMAND ${GIT_EXECUTABLE} --no-optional-locks -C ${SRC_DIR} status --porcelain --untracked-files=no
        OUTPUT_VARIABLE _out RESULT_VARIABLE _rc
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      if(_rc EQUAL 0)
        if(_out STREQUAL "")
          set(_dirty "false")
        else()
          set(_dirty "true")
        endif()
      endif()
    endif()
  endif()
endif()

set(_content "// Generated by cmake/GitInfo.cmake at build time. Do not edit.
#pragma once
#define BENCH_GIT_COMMIT   \"${_commit}\"
#define BENCH_GIT_DESCRIBE \"${_describe}\"
#define BENCH_GIT_DIRTY    \"${_dirty}\"
#define BENCH_GIT_SOURCE   \"${_source}\"
")

# Only touch the file when the content changes (avoids needless recompiles)
set(_old "")
if(EXISTS "${OUT_FILE}")
  file(READ "${OUT_FILE}" _old)
endif()
if(NOT _old STREQUAL _content)
  file(WRITE "${OUT_FILE}" "${_content}")
endif()
